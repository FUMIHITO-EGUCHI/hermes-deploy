# .env.template — copy to .env and fill in non-secret config.
#
# IMPORTANT: Do NOT put API keys here.
#   API keys (DEEPSEEK_API_KEY, etc.) are injected at launch by
#   scripts/start-hermes.ps1 from Bitwarden, never written to disk.
#
# This file is for non-secret config only:
#   - HERMES_DATA   (host data dir path)
#   - Default model selection
#   - Messaging gateway IDs (non-token settings)
#
# .env MUST still be gitignored anyway in case future entries become sensitive.

# -----------------------------------------------------------------------------
# Host data directory (mounted into the container at /opt/data)
# -----------------------------------------------------------------------------
# Where Hermes persists everything: sessions, memories, skills, plans, logs,
# config.yaml. Pick a path OUTSIDE the worktree so it survives worktree
# cleanup AND can be tar/rsync'd to a future VPS / Mini PC.
#
# Windows default — if unset, docker-compose.windows.yml falls back to
# ${USERPROFILE}/.hermes (= C:\Users\<you>\.hermes):
# HERMES_DATA=C:/Users/kurah/.hermes
#
# Linux (VPS / Mini PC) — must set explicitly (USERPROFILE doesn't exist):
# HERMES_DATA=/home/kurah/.hermes

# -----------------------------------------------------------------------------
# Projects workspace directory (mounted into the container at /workspace)
# -----------------------------------------------------------------------------
# Root directory holding every repo you want Hermes to be able to edit.
# Each immediate subdirectory becomes /workspace/<project> inside the
# container. Mounted read-write — Hermes can modify source files.
#
# Windows default — if unset, docker-compose.windows.yml falls back to
# ${USERPROFILE}/Documents/Git (= C:\Users\<you>\Documents\Git):
# HERMES_PROJECTS=C:/Users/kurah/Documents/Git
#
# Linux:
# HERMES_PROJECTS=/home/kurah/code

# -----------------------------------------------------------------------------
# Default model (overridable later via `hermes model` inside the container)
# -----------------------------------------------------------------------------
# Hermes reads model.default from ~/.hermes/config.yaml — this is only a hint
# for first-run setup. Format: provider:model
# HERMES_DEFAULT_MODEL=deepseek:deepseek-chat

# -----------------------------------------------------------------------------
# Messaging gateways — non-secret IDs only (tokens come from Bitwarden flow)
# -----------------------------------------------------------------------------
# Telegram (long-polling — no inbound port needed)
# TELEGRAM_ALLOWED_USERS=123456789,987654321

# Discord (websocket — no inbound port)
# DISCORD_ALLOWED_USERS=

# Slack (Events API — requires public webhook)
# SLACK_ALLOWED_USERS=
